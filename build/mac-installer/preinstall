#!/bin/sh
# Executed by Installer before replacing the bundle; never touches user data.
set -eu
[ "${3:-/}" = / ] || { echo 'Please install on the startup disk.' >&2; exit 1; }
actual_arch=x86_64
if [ "$(/usr/sbin/sysctl -n hw.optional.arm64 2>/dev/null || true)" = 1 ]; then actual_arch=arm64; fi
[ "$actual_arch" = '@ARCH@' ] || { echo 'This installer is for @ARCH@. Download the package for your Mac.' >&2; exit 1; }
[ ! -L '/Applications/DeepSeek Desktop.app' ] || { echo 'The application path is a symlink; installation stopped.' >&2; exit 1; }
uid=$(/usr/bin/stat -f '%u' /dev/console)
case "$uid" in ''|*[!0-9]*) exit 0 ;; esac
[ "$uid" -ge 500 ] || exit 0
for pid in $(/usr/bin/pgrep -u "$uid" -f '/Contents/MacOS/DeepSeek Desktop' || true); do
    binary=$(/bin/ps -ww -p "$pid" -o comm= 2>/dev/null || true)
    case "$binary" in */DeepSeek\ Desktop.app/Contents/MacOS/DeepSeek\ Desktop) ;; *) continue ;; esac
    bundle=${binary%/Contents/MacOS/DeepSeek Desktop}
    identity=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$bundle/Contents/Info.plist" 2>/dev/null || true)
    [ "$identity" = com.deepseek.desktop ] || continue
    /bin/kill -TERM "$pid" 2>/dev/null || true
    attempt=0
    while /bin/kill -0 "$pid" 2>/dev/null; do
        attempt=$((attempt + 1))
        [ "$attempt" -lt 30 ] || { echo 'DeepSeek Desktop did not close. Quit it and try installing again.' >&2; exit 1; }
        /bin/sleep 1
    done
done
