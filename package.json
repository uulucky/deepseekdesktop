{
  "name": "deepseek-desktop",
  "productName": "DeepSeek Desktop",
  "version": "0.2.17",
  "description": "DeepSeek 桌面客户端 — 用 ChatGPT 式原生界面驱动本地 DeepSeek Harness (dsh web) 内核",
  "main": "src/main/index.js",
  "author": "uulucky",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/uulucky/deepseekdesktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uulucky/deepseekdesktop.git"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "ui:shot": "node build/build-main.js && node build/run-ui.js",
    "test": "node test/bootstrap.js && node test/platform.js && node test/updater.js && node test/chat.js && node test/credentials.js && node test/smoke.js",
    "test:portable": "node build/build-main.js && node build/run-probe.js",
    "dist:portable": "electron-builder --win --x64 --dir && node build/make-portable.js && node build/make-update-manifest.js",
    "dist:update-manifest": "node build/make-update-manifest.js",
    "dist:win": "electron-builder --win --x64",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8"
  }
}
