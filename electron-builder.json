{
  "appId": "com.deepseek.desktop",
  "productName": "DeepSeek Desktop",
  "copyright": "Copyright © 2026 uulucky",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "src/**/*",
    "package.json",
    "LICENSE",
    "PRIVACY.md",
    "NETWORK.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "!**/*.map",
    "!**/test/**",
    "!**/build/**",
    "!**/node_modules/**/README.md"
  ],
  "extraMetadata": {
    "main": "src/main/index.js"
  },
  "extraResources": [
    {
      "from": "vendor/node",
      "to": "vendor/node"
    },
    {
      "from": "vendor/kernel",
      "to": "vendor/kernel"
    }
  ],
  "asar": true,
  "mac": {
    "target": ["dmg", "zip"],
    "artifactName": "DeepSeekDesktop-${version}-mac-${arch}.${ext}",
    "category": "public.app-category.productivity",
    "minimumSystemVersion": "14.0",
    "sign": "build/sign-mac.js",
    "hardenedRuntime": true,
    "notarize": false,
    "icon": "build/icon-mac.png"
  },
  "dmg": {
    "sign": false,
    "title": "DeepSeek Desktop",
    "contents": [
      { "x": 130, "y": 220 },
      { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
    ]
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "DeepSeekDesktop-${version}-${channel}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "DeepSeek",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true
  },
  "portable": {
    "artifactName": "DeepSeekDesktop-${version}-单文件便携版.${ext}",
    "requestExecutionLevel": "user"
  },
  "publish": null
}
